            "byField": "path",
            "mode": "inner"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Time 1": true,
              "__name__": true,
              "__name__ 1": true,
              "instance": true,
              "instance 1": true,
              "job": true,
              "job 1": true
            },
            "indexByName": {
              "Value #A": 1,
              "Value #B": 4,
              "location": 3,
              "owner": 2,
              "path": 0
            },
            "renameByName": {
              "Value #A": "SIZE",
              "Value #B": "LAST MODIFIED",
              "location": "LOCATION",
              "owner": "OWNER",
              "path": "PATH"
            }
          }
        }
